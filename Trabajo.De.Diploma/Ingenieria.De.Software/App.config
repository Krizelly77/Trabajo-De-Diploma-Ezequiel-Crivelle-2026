<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<!-- Cadena para la inicialización y creación de la BD -->
		<add name="ConexionMaster"
             connectionString="Data Source=.;Initial Catalog=master;Integrated Security=True;Encrypt=False"
             providerName="System.Data.SqlClient" />

		<!-- Cadena principal para la operación diaria de la app -->
		<add name="MiConexionBiblioteca"
             connectionString="Data Source=.;Initial Catalog=DB_ingenieria_de_software;Integrated Security=True;Encrypt=False"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>